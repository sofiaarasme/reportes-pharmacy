    <connection>Transaccional</connection>
    <sql>SELECT 
    fecha_completa,
    EXTRACT(DAY FROM fecha_completa) AS dia,
    EXTRACT(MONTH FROM fecha_completa) AS mes,
    EXTRACT(YEAR FROM fecha_completa) AS ano
FROM (
    SELECT DISTINCT venta_fecha AS fecha_completa
    FROM venta
    UNION
    SELECT DISTINCT compra_fecha AS fecha_completa
    FROM compra
) AS fechas_unicas
ORDER BY fecha_completa;
</sql>
