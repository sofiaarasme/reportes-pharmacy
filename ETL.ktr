    <connection>Transaccional</connection>
    <sql>SELECT 
    hora_completa,
    EXTRACT(HOUR FROM hora_completa) AS hora,
    EXTRACT(MINUTE FROM hora_completa) AS minuto,
    EXTRACT(SECOND FROM hora_completa) AS segundo
FROM (
    SELECT DISTINCT horario_entrada AS hora_completa
    FROM horario
    UNION
    SELECT DISTINCT horario_salida AS hora_completa
    FROM horario
) AS horas_unicas
ORDER BY hora_completa;</sql>
