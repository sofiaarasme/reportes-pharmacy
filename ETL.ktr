    <connection>Transaccional</connection>
    <sql>SELECT cliente_id,cliente_ci, TRIM(CONCAT(
        cliente_p_nombre, ' ', 
        COALESCE(cliente_s_nombre || ' ', ''), 
        cliente_p_apellido, ' ', 
        COALESCE(cliente_s_apellido, ''))) AS nombre,cliente_direccion
FROM 
    cliente;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
