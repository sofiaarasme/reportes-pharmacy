  <step>
    <name>Hecho_Compra_lotes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>Transaccional</connection>
    <sql>select pr.proveedor_id, pro.producto_id, inv.inventario_id, com.compra_fecha , (dc.detalle_compra_cantidad * dc.detalle_compra_precio_unit) as compra_total 
from proveedor pr, producto pro, inventario inv, compra com, producto_inventario pi, detalle_compra dc
where  pro.producto_id = pi.fk_producto and pi.fk_inventario = inv.inventario_id and pro.producto_id = dc.fk_producto and dc.fk_compra = com.compra_id 
and com.fk_proveedor = pr.proveedor_id</sql>
